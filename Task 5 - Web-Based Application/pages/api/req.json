{
    "Note": "This is a file containing the formats of the requests to be made to the API.",

    "Register an Agency":
    {
        "type": "RegisterAgency",
        "name": "<company name>",
        "email": "<email in valid format>",
        "description": "<description>"
    },

    "Register a Traveller":
    {
        "type": "RegisterTraveller",
        "f_name": "<first name>",
        "mid_init": "<middle initial>",
        "s_name": "<surname>",
        "email": "<email in valid format>",
        "country": "<country of residence>"
    }, 

    "Register a User":
    {
        "type": "RegisterUser",
        "username": "<username>",
        "email": "<email of existing agency or traveller or empty string if admin>",
        "password": "<password>",
        "user_type": "<agency_staff, traveller or admin>"
    },

    "Login": 
    {
        "type": "Login",
        "username": "<username>",
        "password": "<password>"
    }, 

    "Logout":
    {
        "type": "Logout"
    }, 

    "Get Feature for Browsing": 
    {
        "type": "GetFeature",
        "feature": "<destination, flight, attraction, accommodation, restaurant, or activity>"
    },
    
    "Get Packages":{
        "Note": "Only type is required.",
        "Format": 
        {
            "type": "GetPackages",
            "destination": "<country or city>", 
            "min_price": -1.0,
            "max_price": -1.0,
            "duration": -1,
            "package_type": "<solo, couple, group or family>",
            "min_rating": -1.0,
            "sort": "<price_asc, price_desc, rating_desc, duration_asc, or name_asc>"
        }
    },

    "Get Package Details":
    {
        "type": "GetPackageDetails",
        "package_id": -1
    },

    "Get Destinations":
    {
        "type": "GetDestinations"
    }
}
