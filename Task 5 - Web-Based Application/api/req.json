{
    "Note": "This is a file containing the formats of the requests to be made to the API.",

    "Register an Agency":
    {
        "type": "RegisterAgency",
        "name": "<company name>",
        "email": "<email in valid format>",
        "description": "<description>"
    },

    "Register a Traveller":
    {
        "type": "RegisterTraveller",
        "f_name": "<first name>",
        "mid_init": "<middle initial>",
        "s_name": "<surname>",
        "email": "<email in valid format>",
        "country": "<country of residence>"
    }, 

    "Register a User":
    {
        "type": "RegisterUser",
        "username": "<username>",
        "email": "<email of existing agency or traveller or empty string if admin>",
        "password": "<password>",
        "user_type": "<agency_staff, traveller or admin>"
    },

    "Login": 
    {
        "type": "Login",
        "username": "<username>",
        "password": "<password>"
    }, 

    "Logout":
    {
        "type": "Logout"
    }, 

    "Check if user is logged in and get user details":
    {
        "type": "CheckAuthorisation"
    },

    "Get Feature for Browsing": 
    {
        "type": "GetFeature",
        "feature": "<destination, flight, experience, attraction, accommodation, restaurant, or activity>"
    },
    
    "Get Packages":{
        "Note": "Only type is required.",
        "Format": 
        {
            "type": "GetPackages",
            "destination": "<country or city>", 
            "min_price": -1.0,
            "max_price": -1.0,
            "duration": -1,
            "package_type": "<solo, couple, group or family>",
            "min_rating": -1.0,
            "sort": "<price_asc, price_desc, rating_asc, rating_desc, duration_asc, duration_desc, name_asc, or name_desc>"
        }
    },


    "Add Contact deatils (Phone number)":
    {
        "type": "AddContact",
        "user_id": "<ID of the user who inputs the number>"

    },

    "Add Phone number":
    {
        "type": "AddContact",
        "number1": "<mobile num>",
        "number2": "<home num>"
    }, 

    "Get Package Details":
    {
        "type": "GetPackageDetails",
        "package_id": -1
    },

    "Add Experience":
    {
        "type": "AddExperience",
        "name": "<name>",
        "description": "<description>",
        "category": "<accommodation, restaurant, activity or attraction>",
        "availability_status": "<available, unavailable, seasonal>",
        "destination_id": -1
    },

    "Add Accommodation":
    {
        "type": "AddAccommodation",
        "experience_id": -1,
        "stars": -1,
        "capacity": -1,
        "num_rooms": -1,
        "price_per_night": -1.0
    },

    "Add Restaurant":
    {
        "type": "AddRestaurant",
        "experience_id": -1,
        "cuisine": "<cuisine type>",
        "opening_hours": "<opening hours>",
        "price_range": "<price range>"
    },

    "Add Activity":
    {
        "type": "AddActivity",
        "experience_id": -1,
        "activity_type": "<activity type>",
        "price_range": "<price range>",
        "duration": "<duration>",
        "age_restriction": "<age restriction>",
        "capacity": -1,
        "indoor": false
    },

    "Add Attraction":
    {
        "type": "AddAttraction",
        "experience_id": -1,
        "attraction_type": "<attraction type>",
        "opening_hours": "<opening hours>",
        "entry_fee": -1.0
    },

    "Add Package": 
    {
        "type": "AddPackage",
        "name": "<name>",
        "description": "<description>",
        "base_price": -1.0,
        "duration": -1,
        "status": "<draft, active, or archived>"
    },

    "Add Package Agency":
    {
        "type": "AddPackageAgency",
        "package_id": -1,
        "agency_id": -1
    },

    "Add Package Option": 
    {
        "type": "AddPackageOption",
        "package_id": -1,
        "package_type": "<solo, couple, group or family>",
        "participants_min": -1,
        "participants_max": -1, 
        "final_price": -1.0,
        "description": "<description>"
    },

    "Add Package Option Experience":
    {
        "type": "AddPackageOptionExperience",
        "package_id": -1, 
        "package_type": "<solo, couple, group or family>",
        "experience_id": -1
    },

    "Add Package Option Flight":
    {
        "type": "AddPackageOptionFlight",
